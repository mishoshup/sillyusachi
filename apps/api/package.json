		"hono": "^4.13.14",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.9",
		"@types/node": "24",
		"typescript": "6.0.3",
		"vitest": "5.0.5",
		"wrangler": "^4.154.0"
	}
}
