{
	"name": "api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8787",
		"deploy": "wrangler deploy",
		"check": "wrangler types --strict-vars false && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
