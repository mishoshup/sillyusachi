---
import type { Book } from '@sillyusachi/shared';

import { pageCountLabel } from '../book/page-count-label.ts';

interface Props {
	book: Book;
}

const { book } = Astro.props;
---

<figure class="book">
	<img alt="" class="cover" decoding="async" height="1040" src={book.cover} width="736" />
	<figcaption>
		<span class="title">{book.title}</span>
		<span class="count">{pageCountLabel(book.pageCount)}</span>
	</figcaption>
</figure>

<style>
	.book {
		display: grid;
		gap: 0.6rem;
		justify-items: center;
		margin: 0;
	}

	.cover {
		aspect-ratio: 736 / 1040;
		border-radius: 0.4rem 0.9rem 0.9rem 0.4rem;
		box-shadow:
			0 1px 2px rgb(60 40 45 / 18%),
			0 6px 14px rgb(60 40 45 / 14%);
		height: auto;
		object-fit: cover;
		width: 100%;
	}

	figcaption {
		display: grid;
		font-family: var(--pixel);
		justify-items: center;
		line-height: 1.3;
	}

	.title {
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.count {
		color: var(--muted);
		font-size: 0.6rem;
		letter-spacing: 0.08em;
	}
</style>
