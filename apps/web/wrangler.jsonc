{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sillyusachi",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "sillyusachi.com", "custom_domain": true },
		{ "pattern": "www.sillyusachi.com", "custom_domain": true },
	],
	"assets": { "binding": "ASSETS", "directory": "./dist" },
	"observability": { "enabled": true },
	"services": [{ "binding": "API", "service": "sillyusachi-api" }],
	"env": {
		"staging": {
			"name": "sillyusachi-staging",
			"services": [{ "binding": "API", "service": "sillyusachi-api-staging" }],
		},
	},
}
