{
	"name": "sillyusachi",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter web build",
		"check": "bun run --filter '*' check",
		"db:migrate": "bun run --filter api db:migrate",
		"deploy": "bun run --filter api deploy && bun run --filter web deploy",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun run --filter api test"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint-react/eslint-plugin": "5.28.8",
		"@eslint/js": "10.0.1",
		"@types/node": "24",
		"@vitest/eslint-plugin": "1.6.28",
		"astro-eslint-parser": "3.2.0",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-astro": "3.2.1",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y-x": "0.2.0",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-unicorn": "79.0.0",
		"globals": "17.13.0",
		"jiti": "^2.7.0",
		"prettier": "3.9.10",
		"prettier-plugin-astro": "1.1.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1"
	}
}
